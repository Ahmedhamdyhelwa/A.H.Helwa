generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// SaaS Multi-tenancy: Tenant (organization) + Subscription
// =========================================================

enum BusinessType {
  PHARMACY
  RESTAURANT
  SUPERMARKET
  CLOTHING
  ELECTRONICS
  GENERAL
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELED
}

model Tenant {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  businessType    BusinessType       @default(GENERAL)
  currency        String             @default("EGP")
  taxRate         Decimal            @default(14) @db.Decimal(5, 2)
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(TRIAL)
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  users           User[]
  branches        Branch[]
  customers       Customer[]
  suppliers       Supplier[]
  products        Product[]
  categories      Category[]
  salesInvoices   SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  stockMovements  StockMovement[]
  payments        Payment[]
  expenses        Expense[]
  accounts        Account[]
  auditLogs       AuditLog[]
}

// =========================================================
// Users & RBAC
// =========================================================

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
  STOCK_KEEPER
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String
  passwordHash  String
  fullName      String
  role          UserRole @default(CASHIER)
  isActive      Boolean  @default(true)
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id])
  salesInvoices SalesInvoice[]
  auditLogs     AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// =========================================================
// Branches (multi-branch support)
// =========================================================

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  stockMovements    StockMovement[]
  salesInvoices     SalesInvoice[]
  purchaseInvoices  PurchaseInvoice[]
  productStocks     ProductStock[]

  @@index([tenantId])
}

// =========================================================
// Catalog: Categories, Products, Stock per branch
// =========================================================

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  sku           String
  barcode       String?
  name          String
  description   String?
  unit          String   @default("piece")
  categoryId    String?
  costPrice     Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(12, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  reorderLevel  Int      @default(0)
  // Pharmacy fields
  batchNumber   String?
  expiryDate    DateTime?
  // Soft delete
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      Category?         @relation(fields: [categoryId], references: [id])
  stocks        ProductStock[]
  saleItems     SalesInvoiceItem[]
  purchaseItems PurchaseInvoiceItem[]
  movements     StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
}

model ProductStock {
  id        String  @id @default(cuid())
  productId String
  branchId  String
  quantity  Decimal @default(0) @db.Decimal(12, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  productId String
  branchId  String
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3)
  reference String?
  notes     String?
  createdAt DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

// =========================================================
// Customers & Suppliers
// =========================================================

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  payments      Payment[]

  @@index([tenantId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseInvoices  PurchaseInvoice[]
  payments          Payment[]

  @@index([tenantId, name])
}

// =========================================================
// Sales
// =========================================================

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  PARTIAL
  RETURNED
  CANCELED
}

model SalesInvoice {
  id            String        @id @default(cuid())
  tenantId      String
  branchId      String
  number        String
  customerId    String?
  cashierId     String?
  date          DateTime      @default(now())
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  tax           Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paid          Decimal       @default(0) @db.Decimal(14, 2)
  status        InvoiceStatus @default(POSTED)
  isReturn      Boolean       @default(false)
  notes         String?
  createdAt     DateTime      @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch             @relation(fields: [branchId], references: [id])
  customer Customer?          @relation(fields: [customerId], references: [id])
  cashier  User?              @relation(fields: [cashierId], references: [id])
  items    SalesInvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
}

model SalesInvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(14, 2)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// =========================================================
// Purchases
// =========================================================

model PurchaseInvoice {
  id          String        @id @default(cuid())
  tenantId    String
  branchId    String
  number      String
  supplierId  String?
  date        DateTime      @default(now())
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  discount    Decimal       @default(0) @db.Decimal(14, 2)
  tax         Decimal       @default(0) @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  paid        Decimal       @default(0) @db.Decimal(14, 2)
  status      InvoiceStatus @default(POSTED)
  isReturn    Boolean       @default(false)
  notes       String?
  createdAt   DateTime      @default(now())

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch                @relation(fields: [branchId], references: [id])
  supplier Supplier?             @relation(fields: [supplierId], references: [id])
  items    PurchaseInvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
}

model PurchaseInvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitCost  Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  total     Decimal @db.Decimal(14, 2)

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// =========================================================
// Accounting: Accounts (cash, bank), Payments, Expenses
// =========================================================

enum AccountType {
  CASH
  BANK
  RECEIVABLE
  PAYABLE
}

model Account {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(14, 2)
  createdAt DateTime    @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]
  expenses Expense[]

  @@index([tenantId])
}

enum PaymentDirection {
  RECEIPT
  DISBURSEMENT
}

model Payment {
  id          String           @id @default(cuid())
  tenantId    String
  accountId   String
  direction   PaymentDirection
  amount      Decimal          @db.Decimal(14, 2)
  date        DateTime         @default(now())
  customerId  String?
  supplierId  String?
  reference   String?
  notes       String?
  createdAt   DateTime         @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenantId, date])
}

model Expense {
  id         String   @id @default(cuid())
  tenantId   String
  accountId  String
  category   String
  amount     Decimal  @db.Decimal(14, 2)
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([tenantId, date])
}

// =========================================================
// Audit log
// =========================================================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}
